        "UnattendedUserName": "Administrator",
        "UnattendedUserEmail": "admin@example.com",
        "UnattendedUserPassword": "1234567890"
      },
      "ModelsBuilder": {
        "ModelsMode": "InMemoryAuto"
      },
      "Security": {
        "AllowConcurrentLogins": false
      },
      "Imaging": {
        "HMACSecretKey": "cUJBlQOA01lk127cw9LylHWSuv2BCc3hgCZCTScq7RrhhGEyxR2dh1\u002B0Y4ywQcenDH0bv5gavRu1LFq5KcUOww=="
