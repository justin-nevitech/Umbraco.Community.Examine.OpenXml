@using Umbraco.Extensions
@using Umbraco.Cms.Web.Common.PublishedModels
@using Umbraco.Cms.Web.Common.Views
@using Umbraco.Cms.Core.Models.PublishedContent
@using Umbraco.Cms.Core.Services.Navigation
@using Microsoft.AspNetCore.Html
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@*
    Umbraco 18 removed the IPublishedContent.Children property; the replacement is an
    extension method taking the navigation services. Injected here so every view can use it.
*@
@inject IDocumentNavigationQueryService DocumentNavigationQueryService
@inject IPublishedContentStatusFilteringService PublishedContentStatusFilteringService